const SPACE_KEYS = ["kitchen","bathroom","living","bedroom","balcony","study"];

const MATERIAL_CATALOG = [];
SPACE_KEYS.forEach(k => {
  (SPACES[k].materials || []).forEach(m => {
    MATERIAL_CATALOG.push({ id: m.id, name: m.name, space: k, spaceName: SPACES[k].name });
  });
});

const RENDER_IMG = {
  kitchen: '/assets/renders/kitchen.jpg',
  bathroom: '/assets/renders/bathroom.jpg',
  living: '/assets/renders/living.jpg',
  bedroom: '/assets/renders/bedroom.jpg',
  balcony: '/assets/renders/balcony.jpg',
  study: '/assets/renders/study.jpg'
};

const WALLS = [
  { id: 'top', name: '上/北' },
  { id: 'bottom', name: '下/南' },
  { id: 'left', name: '左/西' },
  { id: 'right', name: '右/东' }
];

module.exports = {
  TIERS, TIER_LIST, AD_FEE, adFee, AUX,
  SPACES, SPACE_KEYS, MATERIAL_CATALOG, RENDER_IMG, WALLS,
  setOverride, getOverride,
  tiers, tierList, adFeeMap, aux, spaces, spaceKeys, materialCatalog, walls, renderImg
};

let OVERRIDE = null;
function setOverride(o) { if (o && typeof o === 'object') OVERRIDE = o; }
function getOverride() { return OVERRIDE; }

function tiers() { return (OVERRIDE && OVERRIDE.tiers) || TIERS; }
function tierList() { return (OVERRIDE && OVERRIDE.tierList) || TIER_LIST; }
function adFeeMap() { return (OVERRIDE && OVERRIDE.adFee) || AD_FEE; }
function aux() { return (OVERRIDE && Array.isArray(OVERRIDE.aux)) ? OVERRIDE.aux : AUX; }
function spaces() { return (OVERRIDE && OVERRIDE.spaces) || SPACES; }
function spaceKeys() {
  if (OVERRIDE && OVERRIDE.spaces) return Object.keys(OVERRIDE.spaces);
  return SPACE_KEYS;
}
function materialCatalog() {
  const S = spaces();
  const out = [];
  spaceKeys().forEach(k => {
    (S[k].materials || []).forEach(m => out.push({ id: m.id, name: m.name, space: k, spaceName: S[k].name }));
  });
  return out;
}
function walls() { return WALLS; }
function renderImg() { return RENDER_IMG; }

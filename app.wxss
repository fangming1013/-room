/* ===== 设计系统 token（全局） ===== */
page {
  /* 品牌色阶 */
  --brand: #10B981;
  --brand-deep: #059669;
  --brand-soft: #ECFDF5;
  --brand-line: #A7F3D0;
  /* 中性色阶 */
  --bg: #F8FAFC;
  --card: #FFFFFF;
  --text-1: #0F172A;
  --text-2: #475569;
  --text-3: #94A3B8;
  --line: #E2E8F0;
  --line-soft: #F1F5F9;
  /* 语义色 */
  --price: #F97316;
  --warn: #B45309;
  --warn-bg: #FFFBEB;
  --warn-line: #FDE68A;
  --danger: #EF4444;
  --violet: #8B5CF6;
  /* 圆角 */
  --r-lg: 24rpx;
  --r-md: 16rpx;
  --r-sm: 12rpx;
  /* 阴影 */
  --shadow: 0 6rpx 24rpx rgba(15, 23, 42, .06);
  --shadow-bar: 0 -6rpx 24rpx rgba(15, 23, 42, .06);

  background: var(--bg);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, sans-serif;
  color: var(--text-1);
  font-size: 28rpx;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* 通用卡片 */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.section-h {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin: 8rpx 0 16rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid var(--brand);
}

/* 按钮 */
.btn {
  background: var(--brand);
  color: #fff;
  border: none;
  border-radius: var(--r-md);
  font-size: 30rpx;
  font-weight: 600;
  padding: 22rpx 0;
  text-align: center;
  line-height: 1.3;
}
.btn.ghost { background: var(--brand-soft); color: var(--brand-deep); }
.btn.line { background: #fff; color: var(--brand-deep); border: 2rpx solid var(--brand); }
.btn.plain { background: #fff; color: var(--text-2); border: 2rpx solid var(--line); }
.btn[disabled] { opacity: .45; }

/* 行布局 */
.row { display: flex; align-items: center; }
.muted { color: var(--text-3); }

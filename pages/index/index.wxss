.wrap { padding: 24rpx 0 40rpx; }

/* 首页「空间示意图 + 算法已自动算出 N 项」模块已下线（2026-09-29）
   如需恢复：把 index.js 的 SHOW_PLAN_MINI 改回 true，并加回 wxml 里的 canvas（样式见 git 历史） */

/* 录入方式切换条 */
.chips { white-space: nowrap; display: flex; }
.chip {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  background: var(--line-soft);
  color: var(--text-2);
  border-radius: 999rpx;
  font-size: 28rpx;
}
.chip.on { background: var(--brand); color: #fff; }

/* 语音按钮 */
.voice { flex: 1; background: var(--brand); color: #fff; border-radius: var(--r-md); padding: 22rpx 0; text-align: center; font-size: 30rpx; font-weight: 600; }
.voice.rec { background: var(--danger); }
.voiceText {
  margin-top: 14rpx; font-size: 26rpx; color: var(--brand-deep);
  background: var(--brand-soft); padding: 14rpx 18rpx; border-radius: var(--r-sm);
}

/* 尺寸输入 */
.dims { display: flex; margin-top: 16rpx; }
.dim {
  flex: 1; display: flex; align-items: center; justify-content: center;
  background: var(--line-soft); border-radius: var(--r-sm);
  margin-right: 12rpx; padding: 14rpx 0;
}
.dim text { font-size: 28rpx; color: var(--text-2); }
.dim input { width: 90rpx; text-align: center; font-size: 30rpx; color: var(--text-1); }
.dim .u, .u { font-size: 24rpx; color: var(--text-3); margin-left: 4rpx; }
.lbl { font-size: 28rpx; color: var(--text-2); }
.picker { background: var(--line-soft); padding: 10rpx 24rpx; border-radius: var(--r-sm); font-size: 28rpx; color: var(--text-1); margin-left: 8rpx; }
.winput { width: 90rpx; text-align: center; background: var(--line-soft); border-radius: var(--r-sm); margin-left: 8rpx; font-size: 28rpx; padding: 6rpx 0; color: var(--text-1); }

/* 主材 / 施工 行 */
.mat { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; border-bottom: 1rpx solid var(--line-soft); }
.matl { display: flex; align-items: center; }
.ck { width: 34rpx; height: 34rpx; border-radius: 8rpx; border: 2rpx solid var(--text-3); margin-right: 14rpx; text-align: center; line-height: 30rpx; color: #fff; font-size: 22rpx; }
.ck.on { background: var(--brand); border-color: var(--brand); }
.mn { font-size: 28rpx; color: var(--text-1); }
.matr { display: flex; align-items: center; }
.pr { font-size: 24rpx; color: var(--text-3); margin-right: 12rpx; }
.qty { width: 80rpx; text-align: center; background: var(--line-soft); border-radius: 8rpx; font-size: 28rpx; color: var(--text-1); }

/* 小计 / 合计 */
.total { text-align: right; margin-top: 16rpx; font-size: 28rpx; color: var(--text-2); }
.total .num { color: var(--price); font-weight: 700; font-size: 36rpx; }
.sub { text-align: right; margin-top: 14rpx; font-size: 26rpx; color: var(--text-2); }
.sub .num { color: var(--brand-deep); font-weight: 700; font-size: 30rpx; }

/* 本空间合计卡（品牌实心） */
.totalCard { background: var(--brand); color: #fff; border-radius: var(--r-lg); padding: 30rpx; text-align: center; margin: 20rpx 24rpx; box-shadow: 0 8rpx 22rpx rgba(16, 185, 129, .22); }
.totalCard .gt { font-size: 26rpx; opacity: .9; }
.totalCard .gtn { font-size: 52rpx; font-weight: 800; margin: 8rpx 0; }
.totalCard .gsub { font-size: 22rpx; opacity: .88; }
.cityNote { font-size: 22rpx; color: var(--warn); background: var(--warn-bg); border: 1rpx solid var(--warn-line); border-radius: var(--r-sm); padding: 14rpx 20rpx; margin-top: 16rpx; line-height: 1.5; }

/* 底部生成条 */
.bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 16rpx 24rpx; background: #fff; box-shadow: var(--shadow-bar); }
.gen { width: 100%; }

/* 选品牌弹窗 */
.mask { position: fixed; inset: 0; background: rgba(15, 23, 42, .45); display: flex; align-items: flex-end; z-index: 10; }
.sheet { background: #fff; width: 100%; border-radius: var(--r-lg) var(--r-lg) 0 0; padding: 32rpx; }

/* 门窗宽与定位确认 */
.opRow { display: flex; align-items: center; flex-wrap: wrap; margin: 18rpx 0; }
.opLbl { font-size: 28rpx; color: var(--text-2); }
.opTip { font-size: 22rpx; color: var(--text-3); line-height: 1.6; margin: 6rpx 0 16rpx; }
.sheet .winput { width: 110rpx; margin-left: 4rpx; }
.sheet .u { margin-left: 4rpx; }

/* 手绘弹窗（阶段二，保留样式） */
.preset { background: var(--line-soft); padding: 20rpx; border-radius: var(--r-md); margin: 14rpx 0; font-size: 28rpx; }
.draw { width: 480rpx; height: 380rpx; background: var(--line-soft); border-radius: var(--r-md); }
.drawBar { display: flex; align-items: center; font-size: 24rpx; color: var(--text-2); margin-top: 6rpx; }
.drawBar .cnt { margin-left: auto; color: var(--text-3); }
.drawBar .obtn { flex: none; padding: 12rpx 22rpx; margin-right: 12rpx; }
.drawRow { display: flex; align-items: stretch; gap: 14rpx; margin: 12rpx 0; }
.edgeSide { flex: 1; display: flex; flex-direction: column; justify-content: flex-start; }
.sideHint { font-size: 24rpx; color: var(--brand-deep); background: var(--brand-soft); border-radius: var(--r-sm); padding: 16rpx; line-height: 1.5; }
.sideTip { font-size: 22rpx; color: var(--text-3); margin-top: 16rpx; line-height: 1.5; }
.ubtns { display: flex; gap: 12rpx; margin-top: 16rpx; }
.ubtn { flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--r-sm); font-size: 26rpx; background: var(--brand); color: #fff; }
.ubtn.dis { background: var(--text-3); }
.efT { font-size: 26rpx; color: var(--brand-deep); font-weight: 700; }
.efRow { display: flex; align-items: center; margin-top: 14rpx; font-size: 28rpx; color: var(--text-2); }
.efLen { width: 130rpx; text-align: center; background: #fff; border: 2rpx solid var(--line); border-radius: 8rpx; margin: 0 10rpx; font-size: 30rpx; padding: 8rpx 0; color: var(--text-1); }
.efChips { display: flex; margin-top: 14rpx; gap: 10rpx; }
.efChip { flex: 1; text-align: center; padding: 18rpx 0; border-radius: var(--r-sm); font-size: 28rpx; background: #E5E7EB; color: var(--text-2); }
.efChip.on { background: var(--brand); color: #fff; }
.efRow2 { display: flex; margin-top: 14rpx; gap: 12rpx; }
.efX { flex: 1; text-align: center; padding: 16rpx 0; border-radius: var(--r-sm); background: var(--danger); color: #fff; font-size: 26rpx; }
.efOk { flex: 2; text-align: center; padding: 16rpx 0; border-radius: var(--r-sm); background: var(--brand); color: #fff; font-size: 26rpx; }
.info { font-size: 24rpx; color: var(--brand-deep); font-weight: 700; }
.drawTip { font-size: 22rpx; color: var(--text-3); margin: 8rpx 0; line-height: 1.4; }
.obtn { flex: none; text-align: center; padding: 14rpx 22rpx; border-radius: var(--r-sm); font-size: 26rpx; color: #fff; }
.obtn.win { background: #3A7BD5; }
.obtn.none { background: var(--text-3); }
.btn.disabled { background: var(--text-3); color: #fff; }
/* 全屋拆除联动提示：本空间重复拆除项已按 0 计 */
.dedupNote { font-size: 22rpx; color: #1f8a70; background: #eaf7f1; border-radius: var(--r-sm); padding: 12rpx 18rpx; margin: 0 0 12rpx; line-height: 1.5; }

/* 语音模板卡 */
.tpl { background: var(--brand-soft); border: 2rpx solid var(--brand-line); border-radius: var(--r-md); padding: 22rpx; margin-bottom: 18rpx; }
.tplH { font-size: 26rpx; color: var(--brand-deep); font-weight: 700; }
.tplT { font-size: 30rpx; color: var(--text-1); margin-top: 10rpx; line-height: 1.5; font-weight: 600; }
/* 模板里的具体内容（数字/空间名/材料名）：小字灰色，弱化但不隐藏 */
.tplV { font-size: 22rpx; color: var(--text-3); font-weight: 400; margin: 0 2rpx; }
.tplTip { font-size: 22rpx; color: var(--text-3); margin-top: 10rpx; line-height: 1.5; }

/* 主材品牌档位 */
.tiers { display: flex; align-items: center; flex-wrap: wrap; margin: 14rpx 0 6rpx; }
.tierLbl { font-size: 26rpx; color: var(--text-2); margin-right: 16rpx; }
.tier { padding: 10rpx 24rpx; margin-right: 14rpx; background: var(--line-soft); color: var(--text-2); border-radius: 999rpx; font-size: 26rpx; }
.tier.on { background: var(--brand); color: #fff; }
.tierTip { font-size: 22rpx; color: var(--text-3); margin-bottom: 6rpx; line-height: 1.4; }
.badge { font-size: 20rpx; color: var(--warn); background: var(--warn-bg); border: 1rpx solid var(--warn-line); border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 12rpx; }
.badge.alt { color: var(--brand-deep); background: var(--brand-soft); border-color: var(--brand-line); }
.badge.algo { color: #1f8a70; background: #eaf7f1; border-color: #b9e3cd; }
.algoTag { flex: none; margin-left: 10rpx; padding: 4rpx 14rpx; background: #eaf7f1; color: #1f8a70; border-radius: 999rpx; font-size: 20rpx; }
.pickBrand { flex: none; margin-left: 14rpx; padding: 8rpx 18rpx; background: var(--warn-bg); color: var(--warn); border-radius: 999rpx; font-size: 22rpx; }
.est { flex: none; margin-left: 14rpx; padding: 8rpx 18rpx; background: var(--brand-soft); color: var(--brand-deep); border-radius: 999rpx; font-size: 22rpx; }
.boptH { font-size: 24rpx; color: var(--text-3); margin: 10rpx 0 4rpx; }
.bopt { display: flex; align-items: center; justify-content: space-between; padding: 20rpx; border-radius: var(--r-md); margin: 12rpx 0; background: var(--brand-soft); font-size: 28rpx; }
.bopt.reset { background: var(--line-soft); color: var(--text-3); justify-content: center; }
.bon { color: var(--text-1); }
.bop { color: var(--brand-deep); font-size: 24rpx; }
.boptImg { width: 96rpx; height: 96rpx; border-radius: var(--r-sm); margin-right: 18rpx; flex: none; background: var(--line-soft); }
.boptInfo { flex: 1; display: flex; flex-direction: column; }
.bspec { font-size: 22rpx; color: var(--text-3); margin-top: 4rpx; }
.addwx { flex: none; margin-left: 12rpx; background: #07c160; color: #fff; border-radius: 999rpx; padding: 10rpx 22rpx; font-size: 24rpx; }

/* 录入方式分区标题 */
.mthd { margin-bottom: 18rpx; }
.msec { margin-top: 8rpx; }
.mh { font-size: 30rpx; font-weight: 700; color: var(--text-1); margin: 12rpx 0 14rpx; padding-left: 16rpx; border-left: 8rpx solid var(--brand); }

/* 工程地址 */
.addrRow { display: flex; align-items: center; gap: 14rpx; margin: 12rpx 0 8rpx; }
.albl { font-size: 28rpx; color: var(--text-2); min-width: 120rpx; }
.ainp { flex: 1; background: var(--line-soft); border-radius: var(--r-sm); padding: 16rpx 18rpx; font-size: 28rpx; color: var(--text-1); }
.addrTip { font-size: 22rpx; color: var(--text-3); margin-bottom: 10rpx; line-height: 1.4; }

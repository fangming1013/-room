.wrap { padding: 30rpx 24rpx 60rpx; }
.head { font-size: 40rpx; font-weight: 800; color: var(--brand-deep); padding: 0 4rpx; }
.sub { font-size: 24rpx; color: var(--text-3); margin: 10rpx 0 26rpx; line-height: 1.5; padding: 0 4rpx; }

.empty { background: var(--card); border-radius: var(--r-lg); padding: 80rpx 40rpx; text-align: center; box-shadow: var(--shadow); }
.e1 { font-size: 30rpx; font-weight: 700; color: var(--text-2); }
.e2 { font-size: 24rpx; color: var(--text-3); margin-top: 14rpx; line-height: 1.6; }

.grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.cell { width: 32.5%; margin-bottom: 18rpx; position: relative; background: var(--card); border-radius: var(--r-md); overflow: hidden; box-shadow: var(--shadow); }
.thumb { width: 100%; height: 210rpx; display: block; background: #EEF1F0; }
.cap { font-size: 22rpx; color: var(--text-1); padding: 10rpx 10rpx 0; line-height: 1.3; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cap2 { font-size: 19rpx; color: var(--text-3); padding: 2rpx 10rpx 12rpx; }
.del { position: absolute; right: 0; top: 0; font-size: 19rpx; color: #fff; background: rgba(0,0,0,.45); padding: 4rpx 12rpx; border-radius: 0 0 0 10rpx; }

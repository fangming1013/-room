.wrap { padding: 24rpx 24rpx 60rpx; }
.head { font-size: 38rpx; font-weight: 700; margin: 8rpx 0 20rpx; color: var(--text-1); }

.card { background: var(--card); border-radius: var(--r-lg); padding: 24rpx; margin-bottom: 24rpx; box-shadow: var(--shadow); }
.ct { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 12rpx; }
.sub { font-size: 22rpx; color: var(--text-3); margin-bottom: 14rpx; line-height: 1.5; }

.row { display: flex; align-items: center; gap: 14rpx; margin: 12rpx 0; }
.lbl { font-size: 26rpx; color: var(--text-2); min-width: 90rpx; }
.x { color: var(--text-3); font-size: 26rpx; }
.inp { flex: 1; background: var(--line-soft); border-radius: var(--r-sm); padding: 14rpx 18rpx; font-size: 26rpx; color: var(--text-1); }
.sinp { width: 150rpx; background: var(--line-soft); border-radius: var(--r-sm); padding: 14rpx 16rpx; font-size: 26rpx; text-align: center; color: var(--text-1); }
.sinp2 { width: 130rpx; background: var(--line-soft); border-radius: var(--r-sm); padding: 12rpx 14rpx; font-size: 24rpx; text-align: center; color: var(--text-1); }
.sel { background: var(--brand-soft); color: var(--brand-deep); border-radius: var(--r-sm); padding: 12rpx 18rpx; font-size: 26rpx; }

.btn { background: var(--line-soft); color: var(--text-1); border-radius: var(--r-md); font-size: 28rpx; padding: 20rpx; margin: 10rpx 0; }
.btn.ok { background: var(--brand); color: #fff; font-weight: 600; }
.btn.sm { background: var(--brand); color: #fff; font-size: 24rpx; padding: 10rpx 22rpx; margin: 0; line-height: 1.6; }
.btn.sm.no { background: var(--text-3); }

/* 材料商审核 */
.brandRev { border: 1rpx solid var(--line-soft); border-radius: var(--r-md); padding: 18rpx; margin-bottom: 16rpx; }
.br1 { display: flex; align-items: baseline; justify-content: space-between; }
.brn { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.brf { font-size: 24rpx; color: var(--brand-deep); font-weight: 600; }
.br2 { font-size: 24rpx; color: var(--text-2); margin: 6rpx 0; }
.brqr { margin: 10rpx 0; }
.brqrImg { width: 160rpx; height: 160rpx; border-radius: var(--r-sm); }
.br3 { font-size: 22rpx; color: var(--text-3); margin: 6rpx 0; line-height: 1.5; }
.brAct { display: flex; gap: 16rpx; margin-top: 12rpx; }

.tabs { white-space: nowrap; margin: 4rpx 0 18rpx; }
.tab { display: inline-block; padding: 14rpx 26rpx; margin-right: 12rpx; background: var(--line-soft); color: var(--text-2); border-radius: 999rpx; font-size: 26rpx; }
.tab.on { background: var(--brand); color: #fff; font-weight: 600; }

.item { border: 1rpx solid var(--line-soft); border-radius: var(--r-md); padding: 14rpx; margin-bottom: 14rpx; position: relative; }
.item.dragging { border-color: var(--brand); box-shadow: 0 8rpx 24rpx rgba(0,0,0,.18); transform: scale(1.02); z-index: 5; }
.item.drop { border-top: 6rpx solid var(--brand); }
.itop { display: flex; align-items: center; gap: 12rpx; flex-wrap: wrap; }
.grip { font-size: 34rpx; line-height: 1; color: var(--text-3); width: 44rpx; text-align: center; padding: 6rpx 0; }
.grip:active { color: var(--brand-deep); }
.nm { flex: 1; min-width: 160rpx; background: var(--line-soft); border-radius: 10rpx; padding: 12rpx 14rpx; font-size: 26rpx; color: var(--text-1); }
.tag { font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; color: #fff; }
.tag.m { background: var(--brand); }
.tag.l { background: var(--price); }
.del { color: var(--danger); font-size: 24rpx; padding: 6rpx 10rpx; }
.cp { color: var(--brand-deep); font-size: 24rpx; padding: 6rpx 12rpx; background: var(--brand-soft); border-radius: var(--r-sm); }
.cp:active { opacity: .7; }
.ord { color: var(--text-2); font-size: 24rpx; padding: 6rpx 10rpx; background: var(--line-soft); border-radius: var(--r-sm); }
.ord:active { color: var(--brand-deep); }
.iprice { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 12rpx; }
.pc { display: flex; flex-direction: column; align-items: center; background: var(--line-soft); border-radius: 10rpx; padding: 8rpx 6rpx; }
.pc text { font-size: 20rpx; color: var(--text-3); margin-bottom: 4rpx; }
.pin { width: 120rpx; background: #fff; border: 1rpx solid var(--line); border-radius: 8rpx; padding: 8rpx; font-size: 24rpx; text-align: center; color: var(--text-1); }
.switchline { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: var(--text-2); }

.msg { font-size: 24rpx; color: var(--danger); margin-top: 8rpx; }
.msg.ok { color: var(--brand-deep); }
.msg.tip { color: var(--text-2); line-height: 1.5; }
.tip { font-size: 22rpx; color: var(--text-3); line-height: 1.6; margin-top: 10rpx; }

.bk { display: flex; align-items: center; gap: 12rpx; border: 1rpx solid var(--line-soft); border-radius: var(--r-md); padding: 14rpx; margin-bottom: 12rpx; }
.bk-info { flex: 1; min-width: 0; }
.bk-time { font-size: 24rpx; color: var(--text-1); font-weight: 600; }
.bk-sum { font-size: 20rpx; color: var(--text-3); margin-top: 4rpx; line-height: 1.4; word-break: break-all; }
.bk-act { flex-shrink: 0; }

/* 客资台 */
.lead { border-top: 1rpx solid var(--line-soft); padding: 18rpx 0; }
.leadTop { display: flex; align-items: baseline; }
.leadName { font-size: 28rpx; font-weight: 700; color: var(--text-1); margin-right: 14rpx; }
.leadPhone { font-size: 30rpx; font-weight: 800; color: var(--brand-deep); letter-spacing: 1rpx; }
.leadTime { margin-left: auto; font-size: 22rpx; color: var(--text-3); }
.leadMeta { font-size: 23rpx; color: var(--text-2); margin-top: 6rpx; line-height: 1.5; }
.payIntent { font-size: 23rpx; color: #B45309; background: #FFFBEB; border: 1rpx solid #FDE68A; border-radius: 10rpx; padding: 12rpx 16rpx; margin: 6rpx 0 10rpx; }
.leadAct { display: flex; margin-top: 12rpx; }
.leadAct .btn.sm { margin-right: 12rpx; }
.paidOn { color: var(--brand-deep); font-weight: 700; }
.paidOff { color: var(--danger); font-weight: 600; }

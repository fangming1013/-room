.wrap { padding: 24rpx 24rpx 60rpx; }

.hero { padding: 20rpx 6rpx 18rpx; }
.ht { font-size: 40rpx; font-weight: 800; color: var(--brand-deep); }
.hsub { margin-top: 10rpx; font-size: 24rpx; color: var(--text-3); }

/* 只读记录横幅 */
.roBanner { background: var(--brand-soft); border: 1rpx solid var(--brand-line); border-radius: var(--r-md); padding: 18rpx 22rpx; margin-bottom: 18rpx; font-size: 26rpx; color: var(--brand-deep); font-weight: 600; }
.roMeta { font-size: 24rpx; color: var(--text-2); font-weight: 400; margin-top: 6rpx; }

/* 总预算卡 */
.grand {
  background: var(--brand); color: #fff;
  border-radius: var(--r-lg); padding: 36rpx; text-align: center;
  margin-bottom: 24rpx; box-shadow: 0 8rpx 22rpx rgba(16, 185, 129, .22);
}
.grand .gt { font-size: 26rpx; opacity: .9; }
.grand .gn { font-size: 60rpx; font-weight: 800; margin: 10rpx 0; }
.grand .gs { font-size: 24rpx; opacity: .9; }

.empty { text-align: center; color: var(--text-3); font-size: 28rpx; padding: 40rpx 0; }

/* 各空间行 */
.srow {
  background: var(--card); border-radius: var(--r-lg); padding: 26rpx;
  margin-bottom: 18rpx; box-shadow: var(--shadow);
}
.shead { display: flex; align-items: baseline; justify-content: space-between; }
.sname { font-size: 32rpx; font-weight: 700; color: var(--text-1); }
.sdim { font-size: 22rpx; color: var(--text-3); }
.sbody { display: flex; gap: 18rpx; margin-top: 14rpx; flex-wrap: wrap; }
.sc { font-size: 24rpx; color: var(--text-2); background: var(--line-soft); padding: 8rpx 16rpx; border-radius: 8rpx; }
.st { font-size: 24rpx; color: #fff; background: var(--brand); padding: 8rpx 16rpx; border-radius: 8rpx; font-weight: 700; }
.stip { font-size: 22rpx; color: var(--brand-deep); }
.sacts { display: flex; gap: 16rpx; margin-top: 16rpx; }
.sbtn { flex: 1; text-align: center; font-size: 26rpx; padding: 16rpx 0; border-radius: var(--r-md); border: 2rpx solid var(--line); }
.sbtn:first-child { background: var(--brand); color: #fff; border-color: var(--brand); }
.sbtn:last-child { background: var(--brand-soft); color: var(--brand-deep); }
.sdedup { margin-top: 12rpx; font-size: 22rpx; color: #1f8a70; background: #eaf7f1; border-radius: 8rpx; padding: 8rpx 14rpx; }

.add { margin-top: 20rpx; background: var(--brand); color: #fff; font-size: 30rpx; border-radius: var(--r-md); }
.cityNote { font-size: 22rpx; color: var(--warn); background: var(--warn-bg); border: 1rpx solid var(--warn-line); border-radius: var(--r-sm); padding: 14rpx 20rpx; margin: 18rpx 0; line-height: 1.5; }

/* ===== 辅助项目（与施工项目同格式：名称 ←→ 数量×单价=¥小计） ===== */
.summaryAux {
  background: var(--card); border-radius: var(--r-lg); padding: 24rpx;
  margin-bottom: 18rpx; box-shadow: var(--shadow);
}
.summaryAux .qh {
  font-size: 30rpx; font-weight: 800; color: var(--text-1);
  margin: 24rpx 0 18rpx; padding-left: 16rpx;
  border-left: 8rpx solid var(--brand);
}
.summaryAux .qh:first-of-type { margin-top: 0; }
.summaryAux .qi {
  display: flex; justify-content: space-between; align-items: center;
  font-size: 28rpx; padding: 16rpx 0; border-bottom: 1rpx solid var(--line-soft);
  color: var(--text-1);
}
.summaryAux .qi-r { color: var(--text-3); text-align: right; }
.summaryAux .qsub { text-align: right; font-size: 26rpx; color: var(--text-2); margin: 6rpx 0 4rpx; }
.summaryAux .qname { display: flex; align-items: center; gap: 12rpx; }
.summaryAux .tsw { transform: scale(.7); transform-origin: left center; }
.summaryAux .tin {
  width: 92rpx; min-height: 48rpx; background: var(--line-soft);
  border: 1rpx solid var(--line); border-radius: 8rpx;
  text-align: center; font-size: 24rpx; color: var(--brand-deep); padding: 2rpx 0;
  display: inline-block; vertical-align: middle;
}
.summaryAux .qt { text-align: right; font-size: 30rpx; margin-top: 16rpx; color: var(--text-2); }
.summaryAux .qt text { color: var(--price); font-weight: 700; font-size: 38rpx; }

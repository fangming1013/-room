.wrap { padding: 32rpx 28rpx; }
.head { font-size: 40rpx; font-weight: 800; color: var(--brand-deep); }
.sub { font-size: 24rpx; color: var(--text-3); margin: 10rpx 0 24rpx; }
.empty { text-align: center; color: var(--text-3); font-size: 28rpx; margin-top: 120rpx; }
.grandCard { background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%); border-radius: var(--r-lg); padding: 30rpx 32rpx; margin-bottom: 22rpx; box-shadow: var(--shadow); }
.glabel { font-size: 26rpx; color: rgba(255,255,255,.85); }
.gval { font-size: 52rpx; font-weight: 800; color: #fff; margin-top: 6rpx; letter-spacing: 1rpx; }
.gcount { font-size: 23rpx; color: rgba(255,255,255,.8); margin-top: 6rpx; }
.rec { background: var(--card); border-radius: var(--r-lg); padding: 24rpx 26rpx; margin-bottom: 18rpx; box-shadow: var(--shadow); }
.rtop { display: flex; justify-content: space-between; align-items: baseline; }
.rname { font-size: 30rpx; font-weight: 700; color: var(--text-1); }
.rright { display: flex; align-items: center; gap: 16rpx; }
.rtot { font-size: 32rpx; font-weight: 800; color: var(--price); }
.rdel { font-size: 22rpx; color: var(--danger); background: #FEE2E2; border-radius: 999rpx; padding: 6rpx 16rpx; }
.rmeta { font-size: 24rpx; color: var(--text-2); margin-top: 8rpx; }
.rmeta2 { font-size: 23rpx; color: var(--text-3); margin-top: 4rpx; }
.rgo { font-size: 24rpx; color: var(--brand-deep); margin-top: 12rpx; font-weight: 600; }
.clear { margin-top: 24rpx; background: #FEE2E2; color: var(--danger); font-size: 28rpx; border-radius: var(--r-md); }

.wrap { padding: 20rpx; }
.hero { font-size: 38rpx; font-weight: 800; color: #b8881f; }
.sub1 { font-size: 24rpx; color: #8a9a95; margin: 8rpx 0 18rpx; line-height: 1.5; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 18rpx; }
.title { font-size: 28rpx; font-weight: 700; color: #1f8a70; margin-bottom: 12rpx; }
.row { display: flex; align-items: center; margin: 14rpx 0; }
.lbl { width: 90rpx; font-size: 28rpx; color: #4a5a55; flex: none; }
.inp { flex: 1; background: #f3f6f5; border-radius: 10rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.u { font-size: 24rpx; color: #8a9a95; margin-left: 8rpx; }
.picker { flex: 1; background: #f3f6f5; border-radius: 10rpx; padding: 12rpx 16rpx; font-size: 28rpx; }
.chips { display: flex; flex: 1; }
.chip { padding: 10rpx 24rpx; margin-right: 14rpx; background: #eef2f0; color: #4a5a55; border-radius: 999rpx; font-size: 26rpx; }
.chip.on { background: #1f8a70; color: #fff; }
.adFee { font-size: 26rpx; color: #4a5a55; margin: 14rpx 0; }
.adFee .af { color: #e0533d; font-weight: 700; }
.btn.submit { background: #b8881f; color: #fff; margin-top: 8rpx; }
.rec { padding: 16rpx; border-radius: 12rpx; background: #faf6ec; margin: 12rpx 0; }
.r1 { display: flex; align-items: baseline; }
.rn { font-size: 30rpx; font-weight: 700; color: #2c3a36; }
.rt { font-size: 24rpx; color: #8a9a95; margin-left: 14rpx; }
.r2 { display: flex; align-items: center; gap: 14rpx; font-size: 26rpx; color: #1f8a70; margin-top: 6rpx; }
.tag { background: #e8f3ef; color: #1f8a70; border-radius: 8rpx; padding: 2rpx 10rpx; }
.ad { color: #b8881f; }
.r3 { font-size: 22rpx; color: #8a9a95; margin-top: 6rpx; }
.pay { margin-top: 10rpx; text-align: center; background: #1f8a70; color: #fff; border-radius: 10rpx; padding: 14rpx; font-size: 26rpx; }
.foot { font-size: 22rpx; color: #8a9a95; line-height: 1.5; margin: 10rpx 0 30rpx; }

/* 微信二维码 */
.row.col { flex-direction: column; align-items: flex-start; }
.row.col .lbl { margin-bottom: 10rpx; }
.tip { font-size: 22rpx; color: #8a9a95; margin-top: 8rpx; }
.qrBox { width: 220rpx; height: 220rpx; border: 2rpx dashed #c7d2cd; border-radius: 12rpx; overflow: hidden; display: flex; align-items: center; justify-content: center; background: #fafbfa; }
.qrImg { width: 220rpx; height: 220rpx; }
.qrEmpty { font-size: 24rpx; color: #8a9a95; text-align: center; padding: 0 16rpx; }

/* 单位必选 */
.upicker { width: 160rpx; flex: none; background: #f3f6f5; border-radius: 10rpx; padding: 12rpx 16rpx; font-size: 28rpx; margin-left: 8rpx; }
.upicker.ph { color: #aab4b0; }

/* 多图选择 */
.imgGrid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.thumb { position: relative; width: 150rpx; height: 150rpx; border-radius: 10rpx; overflow: hidden; background: #eef2f0; }
.thumbImg { width: 150rpx; height: 150rpx; }
.thumb.add { display: flex; align-items: center; justify-content: center; border: 2rpx dashed #c7d2cd; color: #b3bdbc; font-size: 56rpx; }
.thumb .del { position: absolute; top: 0; right: 0; width: 40rpx; height: 40rpx; line-height: 40rpx; text-align: center; background: rgba(0,0,0,.55); color: #fff; font-size: 30rpx; border-bottom-left-radius: 10rpx; }

/* 已添加产品 */
.prod { padding: 16rpx; border-radius: 12rpx; background: #faf6ec; margin: 12rpx 0; position: relative; }
.r3 { font-size: 22rpx; color: #8a9a95; margin-top: 6rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.miniImg { width: 80rpx; height: 80rpx; border-radius: 8rpx; }
.miniQR { width: 120rpx; height: 120rpx; border-radius: 8rpx; }
.del2 { margin-top: 10rpx; text-align: center; background: #f3e3e0; color: #c0392b; border-radius: 10rpx; padding: 10rpx; font-size: 24rpx; }
.addP { background: #1f8a70; color: #fff; margin-top: 16rpx; }
.st.ok { background: #e8f3ef; color: #1f8a70; border-radius: 8rpx; padding: 2rpx 10rpx; font-size: 22rpx; }
.st.wt { background: #fcf3df; color: #b8881f; border-radius: 8rpx; padding: 2rpx 10rpx; font-size: 22rpx; }
.st.off { background: #f3e3e0; color: #c0392b; border-radius: 8rpx; padding: 2rpx 10rpx; font-size: 22rpx; }
